package Java_assignment_2;

class CellPhone
{
    public String model="unknown";
    public String[] contact = new String[3];

    int i = 0;
    int count=0;
    void storeContact(String c)
    {
        if(count == 3)
        {
            System.out.println("Memory full. New contact can't be stored.");
        }
        else
        {
            if(i<3)
            {
                contact[i] = c;
                System.out.println("Contact Stored");
                count++;
                i++;
            }
        }

    }

    void printDetails()
    {
        System.out.println("Phone Model = "+model);
        System.out.println("Contacts Stored = "+count);

        if(count>0)
        {
            System.out.println("Stored Contacts:");
            for(int j=0; j<count; j++)
            {
                System.out.println(contact[j]);
            }
        }

    }

}
public class Task_7
{
    public static void main(String[] args)
    {
        CellPhone phone1 = new CellPhone();
        phone1.printDetails();
        phone1.model = "Nokia 1100";
        System.out.println("1##################");
        phone1.storeContact("Joy - 01834");
        System.out.println("===================");
        phone1.printDetails();
        System.out.println("2##################");
        phone1.storeContact("Toya - 01334");
        phone1.storeContact("Aayan - 01135");
        System.out.println("===================");
        phone1.printDetails();
        System.out.println("3##################");
        phone1.storeContact("Sani - 01441");
        System.out.println("===================");
        phone1.printDetails();
    }
}
